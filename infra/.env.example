LIVEKIT_API_KEY=example_key
LIVEKIT_API_SECRET=example_secret_do_not_use_in_production
LIVEKIT_PUBLIC_URL=wss://stackcall.80-190-79-129.sslip.io/rtc
# No Compose, o porteiro usa http://livekit:7880 para administrar as salas.
SERVIDOR_URL=https://stackcall.80-190-79-129.sslip.io
SERVIDOR_NOME=Stackcall
MEMBROS_CONVIDAM=false
PORTEIRO_ADDR=0.0.0.0:8100
PORTEIRO_TRUSTED_PROXY=172.31.240.1
# 0 mantém o LiveKit ligado. Para ativar use também docker-compose.sleep.yml.
LIVEKIT_IDLE_MINUTES=0
# LIVEKIT_KEYS is composed from LIVEKIT_API_KEY and LIVEKIT_API_SECRET.
