{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stackcall",
  "version": "0.4.0",
  "identifier": "io.github.stackcall",
  "build": {
    "beforeDevCommand": "set \"PSModulePath=\" & powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/preparar-ffmpeg.ps1 && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "set \"PSModulePath=\" & powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/preparar-ffmpeg.ps1 && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stackcall",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#f4f4f1",
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:*; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "sidecar/stackcall-core"
    ],
    "resources": {
      "sidecar/avcodec-63.dll": "avcodec-63.dll",
      "sidecar/avutil-61.dll": "avutil-61.dll",
      "sidecar/swscale-10.dll": "swscale-10.dll",
      "sidecar/swresample-7.dll": "swresample-7.dll",
      "sidecar/FFmpeg-LGPL.txt": "FFmpeg-LGPL.txt",
      "sidecar/FFmpeg-GPL.txt": "FFmpeg-GPL.txt",
      "../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "instalador/cabecalho.bmp",
        "sidebarImage": "instalador/lateral.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRkQzRUM5MDc2MEZCNDIKUldSQysyQUh5VDc5VzIzeVN6Qm9CczlUUTQ5YThGU241bnBHNGVKekQ2ZDBmVmZ2K3IwN09HRFgK",
      "endpoints": [
        "https://github.com/stackcall/releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "stackcall"
        ]
      }
    }
  }
}
